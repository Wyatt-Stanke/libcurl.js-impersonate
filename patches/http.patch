   curl_easy_setopt(http_handle, CURLOPT_HTTP_VERSION, CURL_HTTP_VERSION_2_0);
-  curl_easy_setopt(http_handle, CURLOPT_IGNORE_ONION, 1L);
+  curl_easy_setopt(http_handle, CURLOPT_SSL_CTX_FUNCTION, chrome_ssl_ctx_cb);
